{
  "entities": {
    "ClientDossier": {
      "title": "ClientDossier",
      "description": "Acquirer / buyer dossier managed by the advisor and accessible in filtered form from the Buyer Portal.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Authenticated advisor UID owning this workspace" },
        "name": { "type": "string", "description": "Display name of the buyer dossier" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "situation": { "type": "string" },
        "status": { "type": "string" },
        "projectStage": { "type": "integer", "description": "0 to 5 pipeline stage index" },
        "budgetMax": { "type": "integer" },
        "downPayment": { "type": "integer" },
        "monthlyIncome": { "type": "integer" },
        "existingCredits": { "type": "integer" },
        "bankApproval": { "type": "string" },
        "sectors": { "type": "array", "description": "Target Montpellier sectors" },
        "propertyType": { "type": "string" },
        "minSurface": { "type": "integer" },
        "minRooms": { "type": "integer" },
        "essentialCriteria": { "type": "array" },
        "secondaryCriteria": { "type": "array" },
        "timelineDelai": { "type": "string" },
        "clientMessageToAdvisor": { "type": "string" },
        "criteriaModifiedByClient": { "type": "boolean" },
        "lastClientUpdateLabel": { "type": "string" },
        "selectedPropertyIds": { "type": "array" },
        "propertyFeedback": { "type": "object", "description": "Map of propertyId -> rating/status/comment" },
        "portalActive": { "type": "boolean" },
        "portalToken": { "type": "string" },
        "portalExpiration": { "type": "string" },
        "privateNotes": { "type": "string", "description": "Confidential advisor notes hidden from Buyer Portal" },
        "timeline": { "type": "array", "description": "Chronological activity entries" },
        "rgpdConsentGranted": { "type": "boolean" },
        "rgpdConsentDate": { "type": "string" },
        "searchCenterAddress": { "type": "string" },
        "searchCenterLat": { "type": "number" },
        "searchCenterLon": { "type": "number" },
        "searchMode": { "type": "string", "enum": ["SECTOR_LIST", "RADIUS_KM", "TRAVEL_TIME"] },
        "searchRadiusKm": { "type": "integer" },
        "searchMaxTravelMinutes": { "type": "integer" },
        "searchTransportMode": { "type": "string", "enum": ["VOITURE", "TRAM", "BUS", "TRAIN", "VELO", "PIED"] },
        "createdAt": { "type": "string", "format": "date-time", "description": "ServerTimestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "ServerTimestamp" }
      },
      "required": ["userId", "name", "budgetMax", "projectStage", "portalActive", "createdAt", "updatedAt"]
    },
    "PropertyItem": {
      "title": "PropertyItem",
      "description": "Real estate listing in Montpellier & Metropole evaluated for compatibility.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "sector": { "type": "string" },
        "address": { "type": "string" },
        "type": { "type": "string" },
        "price": { "type": "integer" },
        "surface": { "type": "integer" },
        "rooms": { "type": "integer" },
        "bedrooms": { "type": "integer" },
        "floor": { "type": "string" },
        "dpe": { "type": "string" },
        "ges": { "type": "string" },
        "monthlyCharges": { "type": "integer" },
        "propertyTax": { "type": "integer" },
        "estimatedWorks": { "type": "integer" },
        "listingStatus": { "type": "string" },
        "source": { "type": "string" },
        "exterior": { "type": "string" },
        "parking": { "type": "string" },
        "environment": { "type": "string" },
        "transports": { "type": "string" },
        "schoolsShops": { "type": "string" },
        "generalCondition": { "type": "string" },
        "strengths": { "type": "array" },
        "weaknesses": { "type": "array" },
        "description": { "type": "string" },
        "mandateRef": { "type": "string" },
        "mandateType": { "type": "string" },
        "mandateDate": { "type": "string" },
        "agencyFeePercent": { "type": "number" },
        "listingUrl": { "type": "string" },
        "listingPortal": { "type": "string" },
        "dvfEstimatedEuro": { "type": "integer" },
        "dvfEstimatedLowEuro": { "type": "integer" },
        "dvfEstimatedHighEuro": { "type": "integer" },
        "dvfScore": { "type": "integer" },
        "dvfCriteriaSummary": { "type": "string" },
        "advisorValuationNotes": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "publisherType": { "type": "string", "enum": ["AGENCE", "PARTICULIER"] },
        "publisherName": { "type": "string" },
        "publicationStatus": { "type": "string", "enum": ["BROUILLON", "A_VERIFIER", "PUBLIEE"] },
        "hideExactAddress": { "type": "boolean" },
        "ownerConfirmedAccuracy": { "type": "boolean" },
        "legalPublicationConsent": { "type": "boolean" },
        "photoVaultPaths": { "type": "array" },
        "photoCount": { "type": "integer" },
        "saleDelayMinDays": { "type": "integer" },
        "saleDelayLikelyDays": { "type": "integer" },
        "saleDelayMaxDays": { "type": "integer" },
        "saleDelayConfidence": { "type": "string" },
        "saleDelaySummary": { "type": "string" },
        "cadastralRef": { "type": "string" },
        "pluZone": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "sector", "type", "price", "surface", "bedrooms", "dpe", "createdAt", "updatedAt"]
    },
    "VisitRecord": {
      "title": "VisitRecord",
      "description": "Property visit or client visit request with shared feedback.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "timeSlot": { "type": "string" },
        "clientId": { "type": "string" },
        "propertyId": { "type": "string" },
        "status": { "type": "string" },
        "overallRating": { "type": "number" },
        "clientImpressions": { "type": "string" },
        "positives": { "type": "string" },
        "negatives": { "type": "string" },
        "technicalNotes": { "type": "string" },
        "nextAction": { "type": "string" },
        "sharedWithClient": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "timeSlot", "clientId", "propertyId", "status", "sharedWithClient", "createdAt", "updatedAt"]
    },
    "OfferRecord": {
      "title": "OfferRecord",
      "description": "Purchase offer and negotiation record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "clientId": { "type": "string" },
        "propertyId": { "type": "string" },
        "askingPrice": { "type": "integer" },
        "offeredPrice": { "type": "integer" },
        "estimatedWorks": { "type": "integer" },
        "status": { "type": "string" },
        "sellerContext": { "type": "string" },
        "clientFinancing": { "type": "string" },
        "suspensiveConditions": { "type": "string" },
        "arguments": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "clientId", "propertyId", "askingPrice", "offeredPrice", "status", "createdAt", "updatedAt"]
    },
    "BuyerChatMessage": {
      "title": "BuyerChatMessage",
      "description": "AI-powered Buyer Assistant Q&A messages inside the client's dossier tab.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "clientId": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "assistant"] },
        "content": { "type": "string" },
        "topic": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "clientId", "role", "content", "createdAt", "updatedAt"]
    },
    "AgencyOrg": {
      "title": "AgencyOrg",
      "description": "Multi-agency organization or independent agent workspace with subscription plan and RBAC membership arrays.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "plan": { "type": "string", "enum": ["INDIVIDUAL", "AGENCY"] },
        "subscriptionStatus": { "type": "string", "enum": ["ACTIVE", "TRIAL"] },
        "ownerUid": { "type": "string" },
        "city": { "type": "string" },
        "inviteCode": { "type": "string" },
        "directorUids": { "type": "array" },
        "memberUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "plan", "subscriptionStatus", "ownerUid", "directorUids", "memberUids", "createdAt", "updatedAt"]
    },
    "AgencyMember": {
      "title": "AgencyMember",
      "description": "Collaborator, agency manager, or administrator inside an agency with strict RBAC role.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "DIRECTOR", "AGENT"] },
        "status": { "type": "string", "enum": ["ACTIVE", "INVITED"] },
        "inviteCode": { "type": "string" },
        "viewerUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agencyId", "email", "displayName", "role", "status", "viewerUids", "createdAt", "updatedAt"]
    },
    "CrmContact": {
      "title": "CrmContact",
      "description": "Full real-estate CRM contact isolated by agency and collaborator assignment.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string" },
        "createdByUid": { "type": "string" },
        "assignedToUid": { "type": "string" },
        "assignedToName": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fullName": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "postalAddress": { "type": "string" },
        "contactType": { "type": "string", "enum": ["Acquéreur", "Vendeur", "Propriétaire", "Locataire", "Investisseur", "Partenaire", "Autre", "Mixte"] },
        "status": { "type": "string" },
        "priority": { "type": "string", "enum": ["Faible", "Normal", "Élevé", "Urgent"] },
        "budgetMin": { "type": "integer" },
        "budgetMax": { "type": "integer" },
        "sector": { "type": "string" },
        "desiredPropertyType": { "type": "string" },
        "desiredSurfaceMin": { "type": "integer" },
        "desiredRoomsMin": { "type": "integer" },
        "financingMode": { "type": "string" },
        "projectTimeline": { "type": "string" },
        "source": { "type": "string" },
        "notes": { "type": "string" },
        "lastContactedAt": { "type": "string" },
        "nextFollowUpAt": { "type": "string" },
        "linkedPropertyId": { "type": "string" },
        "linkedPropertyTitle": { "type": "string" },
        "archived": { "type": "boolean" },
        "exchangeLogs": { "type": "array" },
        "viewerUids": { "type": "array" },
        "rgpdConsentGranted": { "type": "boolean" },
        "rgpdConsentDate": { "type": "string" },
        "rgpdLegalBasis": { "type": "string" },
        "rgpdRetentionUntil": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agencyId", "createdByUid", "assignedToUid", "assignedToName", "fullName", "contactType", "status", "viewerUids", "createdAt", "updatedAt"]
    },
    "FollowUpTask": {
      "title": "FollowUpTask",
      "description": "Commercial follow-up reminder or automated relance task with date and time.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string" },
        "contactId": { "type": "string" },
        "contactName": { "type": "string" },
        "createdByUid": { "type": "string" },
        "assignedToUid": { "type": "string" },
        "assignedToName": { "type": "string" },
        "title": { "type": "string" },
        "channel": { "type": "string", "enum": ["Appel", "Email", "SMS", "Visite"] },
        "dueDate": { "type": "string" },
        "dueTime": { "type": "string" },
        "priority": { "type": "string", "enum": ["Faible", "Normale", "Haute", "Urgente", "Basse", "Normal", "Élevé", "Urgent"] },
        "status": { "type": "string", "enum": ["À faire", "En cours", "Terminée"] },
        "autoGenerated": { "type": "boolean" },
        "viewerUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agencyId", "contactName", "createdByUid", "assignedToUid", "assignedToName", "title", "channel", "dueDate", "priority", "status", "viewerUids", "createdAt", "updatedAt"]
    },
    "AgencyAuditLog": {
      "title": "AgencyAuditLog",
      "description": "Immutable chronological audit trail of key agency, team, CRM, and follow-up actions.",
      "type": "object",
      "properties": {
        "agencyId": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string" },
        "actionType": { "type": "string" },
        "targetLabel": { "type": "string" },
        "detail": { "type": "string" },
        "viewerUids": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["agencyId", "actorUid", "actorName", "actionType", "targetLabel", "detail", "viewerUids", "createdAt"]
    },
    "AgencyInvite": {
      "title": "AgencyInvite",
      "description": "Single-use invitation token to join an agency as AGENT.",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string" },
        "agencyId": { "type": "string" },
        "agencyName": { "type": "string" },
        "targetEmail": { "type": "string" },
        "targetName": { "type": "string" },
        "role": { "type": "string", "enum": ["AGENT"] },
        "directorUid": { "type": "string" },
        "used": { "type": "boolean" },
        "claimedByUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["inviteCode", "agencyId", "agencyName", "role", "directorUid", "used", "createdAt", "updatedAt"]
    },
    "SellerPropertyDossier": {
      "title": "SellerPropertyDossier",
      "description": "Seller workspace document vault (Maison/Appartement essentials, Loi ALUR residence docs, free buyer summary, and paid buyer document orders).",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "propertyId": { "type": "string" },
        "propertyTitle": { "type": "string" },
        "propertyKind": { "type": "string", "enum": ["Maison", "Appartement"] },
        "residenceType": { "type": "string", "enum": ["Maison individuelle", "Résidence / Copropriété", "Lotissement ASL"] },
        "sellerName": { "type": "string" },
        "sellerEmail": { "type": "string" },
        "sellerPhone": { "type": "string" },
        "mandateRef": { "type": "string" },
        "mandateType": { "type": "string" },
        "mandateDate": { "type": "string" },
        "agencyFeePercent": { "type": "number" },
        "listingUrl": { "type": "string" },
        "listingPortal": { "type": "string" },
        "advisorEstimatedEuro": { "type": "integer" },
        "advisorValuationNotes": { "type": "string" },
        "syndicName": { "type": "string" },
        "annualCoproCharges": { "type": "integer" },
        "alurWorkFundEuro": { "type": "integer" },
        "packPriceEuro": { "type": "integer" },
        "paymentLinkUrl": { "type": "string" },
        "executiveSummary": { "type": "string" },
        "documents": { "type": "array" },
        "buyerOrders": { "type": "array" },
        "dvfValuation": { "type": "object" },
        "callbackRequests": { "type": "array" },
        "rgpdConsentGranted": { "type": "boolean" },
        "rgpdConsentDate": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "propertyId", "propertyTitle", "propertyKind", "residenceType", "packPriceEuro", "documents", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}/clients/{clientId}": {
      "schema": { "$ref": "#/entities/ClientDossier" },
      "description": "Buyer dossiers owned by the authenticated user."
    },
    "/users/{userId}/properties/{propertyId}": {
      "schema": { "$ref": "#/entities/PropertyItem" },
      "description": "Property portfolio owned by the authenticated user."
    },
    "/users/{userId}/visits/{visitId}": {
      "schema": { "$ref": "#/entities/VisitRecord" },
      "description": "Scheduled visits and visit reports."
    },
    "/users/{userId}/offers/{offerId}": {
      "schema": { "$ref": "#/entities/OfferRecord" },
      "description": "Purchase offers and negotiation records."
    },
    "/users/{userId}/buyer_chats/{messageId}": {
      "schema": { "$ref": "#/entities/BuyerChatMessage" },
      "description": "Buyer AI assistant conversation history scoped by user."
    },
    "/users/{userId}/seller_dossiers/{dossierId}": {
      "schema": { "$ref": "#/entities/SellerPropertyDossier" },
      "description": "Seller workspace document vaults (Maison/Appartement essentials, Loi ALUR residence docs, buyer summary & orders)."
    },
    "/agencies/{agencyId}": {
      "schema": { "$ref": "#/entities/AgencyOrg" },
      "description": "Multi-agency workspaces and independent agent organizations."
    },
    "/agencies/{agencyId}/members/{memberId}": {
      "schema": { "$ref": "#/entities/AgencyMember" },
      "description": "Agency directors, collaborators, and invited seats."
    },
    "/agencies/{agencyId}/contacts/{contactId}": {
      "schema": { "$ref": "#/entities/CrmContact" },
      "description": "CRM contacts scoped to agency and assigned collaborator."
    },
    "/agencies/{agencyId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/FollowUpTask" },
      "description": "Daily commercial follow-up reminders and automated tasks."
    },
    "/agencies/{agencyId}/audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AgencyAuditLog" },
      "description": "Immutable audit trail for agency accountability."
    },
    "/agency_invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/AgencyInvite" },
      "description": "Single-use invitation codes for joining an agency."
    }
  }
}
